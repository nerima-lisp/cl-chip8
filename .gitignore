# nerima-lisp standard .gitignore
# Everything above the marker must stay identical across repos so that "is
# this artifact ignored?" has the same answer everywhere.

# --- Common Lisp build output ---
*.fasl
*.fas
*.lib
*.dfsl
*.ufsl
*.fsl

# --- Nix ---
/result
/result-*
/.direnv/

# --- Test and coverage output ---
/coverage/
/coverage-report/
/*-coverage-report/
*.coverage
coverage.dat
/__snapshots__/
/*-snapshots/

# --- Local caches and scratch space ---
/.cache/
/.deps/
/tmp/
/.worktrees/
/.paredit.cleanup/

# --- Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/secrets/

# --- Editor and OS noise ---
.DS_Store
*~
\#*\#
.\#*

# --- Repository-specific entries below this line ---
