(in-package #:cl-chip8)
(defstruct (chip8-machine (:constructor %make-chip8-machine))
  (platform (find-chip8-platform :modern) :type chip8-platform)
  (memory (make-array +memory-size+ :element-type 'chip8-octet :initial-element 0)
          :type (simple-array chip8-octet (*)))
  (v (make-array 16 :element-type 'chip8-octet :initial-element 0)
     :type (simple-array chip8-octet (16)))
  (i 0 :type (unsigned-byte 16))
  (pc #x200 :type chip8-program-counter)
  (sp 0 :type (integer 0 16))
  (stack (make-array 16 :element-type '(unsigned-byte 16) :initial-element 0)
         :type (simple-array (unsigned-byte 16) (16)))
  (delay-timer 0 :type chip8-octet)
  (sound-timer 0 :type chip8-octet)
  (audio-pattern (make-array 16 :element-type 'chip8-octet :initial-element 0)
                 :type (simple-array chip8-octet (16)))
  (xo-audio-instructions-used-p nil :type boolean)
  (pitch 64 :type chip8-octet)
  (halted-p nil :type boolean)
  (keypad (make-array 16 :element-type 'bit :initial-element 0)
          :type (simple-array bit (16)))
  (framebuffer
   (make-array (list +physical-display-height+ +physical-display-width+)
               :element-type '(unsigned-byte 2)
               :initial-element 0)
   :type chip8-framebuffer)
  (display-audio-lock nil)
  (resolution-state :lores :type (member :lores :hires))
  (plane-mask-state 1 :type (unsigned-byte 2))
  (quirks (make-chip8-quirks) :type chip8-quirks)
  (waiting (make-chip8-wait-state) :type chip8-wait-state)
  (instructions 0 :type (unsigned-byte 64)))

(progn
  (defvar *display-audio-lock-timing-hook* nil)

  (defmacro with-display-audio-lock (lock-form &body body)
    (let ((hook (gensym "HOOK"))
          (wait-start (gensym "WAIT-START"))
          (hold-start (gensym "HOLD-START"))
          (hold-end (gensym "HOLD-END"))
          (results (gensym "RESULTS")))
      `(let ((,hook *display-audio-lock-timing-hook*))
         (if ,hook
             (let ((,wait-start (get-internal-real-time))
                   (,hold-start nil)
                   (,hold-end nil)
                   (,results nil))
               (setf ,results
                     (multiple-value-list
                      (with-lock-held ,lock-form
                        (setf ,hold-start (get-internal-real-time))
                        (multiple-value-prog1 (progn ,@body)
                          (setf ,hold-end (get-internal-real-time))))))
               (funcall ,hook :wait
                        (/ (- ,hold-start ,wait-start)
                           internal-time-units-per-second))
               (funcall ,hook :hold
                        (/ (- ,hold-end ,hold-start)
                           internal-time-units-per-second))
               (values-list ,results))
             (with-lock-held ,lock-form
               ,@body))))))
