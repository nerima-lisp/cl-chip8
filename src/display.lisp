(in-package #:cl-chip8)

(defun display-reset! (machine)
  (with-lock-held ((chip8-machine-framebuffer-lock machine))
    (let ((framebuffer (chip8-machine-framebuffer machine)))
      (dotimes (index (* +physical-display-width+ +physical-display-height+))
        (setf (row-major-aref framebuffer index) 0))))
  machine)

(defun %check-display-coordinate (machine x y)
  (check-type x (integer 0 *))
  (check-type y (integer 0 *))
  (unless (and (< x (chip8-machine-logical-width machine))
               (< y (chip8-machine-logical-height machine)))
    (error "Display coordinate (~D, ~D) is outside the ~Dx~D logical display."
           x y
           (chip8-machine-logical-width machine)
           (chip8-machine-logical-height machine))))

(defun %logical-pixel-value-unlocked (machine x y)
  (let* ((scale (if (eq (chip8-machine-resolution machine) :hires) 1 2))
         (origin-x (* x scale))
         (origin-y (* y scale))
         (framebuffer (chip8-machine-framebuffer machine))
         (value 0))
    (dotimes (dy scale value)
      (dotimes (dx scale)
        (setf value
              (logior value
                      (aref framebuffer (+ origin-y dy) (+ origin-x dx))))))))

(defun display-pixel-value (machine x y
                            &optional (plane-mask (chip8-machine-plane-mask machine)))
  (check-type plane-mask (unsigned-byte 2))
  (%check-display-coordinate machine x y)
  (with-lock-held ((chip8-machine-framebuffer-lock machine))
    (logand plane-mask (%logical-pixel-value-unlocked machine x y))))

(defun chip8-framebuffer-snapshot (machine)
  (with-lock-held ((chip8-machine-framebuffer-lock machine))
    (let* ((width (chip8-machine-logical-width machine))
           (height (chip8-machine-logical-height machine))
           (copy (make-array (list height width)
                             :element-type '(unsigned-byte 2))))
      (dotimes (y height copy)
        (dotimes (x width)
          (setf (aref copy y x)
                (%logical-pixel-value-unlocked machine x y)))))))

(defun chip8-framebuffer (machine)
  (chip8-framebuffer-snapshot machine))

(defun display-xor-pixel! (machine x y
                           &optional (plane-mask (chip8-machine-plane-mask machine)))
  (check-type plane-mask (unsigned-byte 2))
  (%check-display-coordinate machine x y)
  (with-lock-held ((chip8-machine-framebuffer-lock machine))
    (%display-xor-pixel-unlocked! machine x y plane-mask)))

(defun %display-xor-pixel-unlocked! (machine x y plane-mask)
  (let* ((scale (if (eq (chip8-machine-resolution machine) :hires) 1 2))
         (origin-x (* x scale))
         (origin-y (* y scale))
         (framebuffer (chip8-machine-framebuffer machine))
         (collision nil))
    (dotimes (dy scale collision)
      (dotimes (dx scale)
        (let* ((physical-y (+ origin-y dy))
               (physical-x (+ origin-x dx))
               (old (aref framebuffer physical-y physical-x)))
          (setf (aref framebuffer physical-y physical-x)
                (logxor old plane-mask))
          (when (logtest old plane-mask)
            (setf collision t)))))))

(defun chip8-clear-display! (machine &optional (plane-mask #b11))
  (check-type plane-mask (unsigned-byte 2))
  (with-lock-held ((chip8-machine-framebuffer-lock machine))
    (let ((framebuffer (chip8-machine-framebuffer machine)))
      (dotimes (index (* +physical-display-width+ +physical-display-height+))
        (setf (row-major-aref framebuffer index)
              (logandc2 (row-major-aref framebuffer index) plane-mask)))))
  machine)
