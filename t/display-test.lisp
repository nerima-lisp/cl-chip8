(in-package #:cl-chip8/test)
(describe "machine framebuffer"
  (it "uses a 2-bit physical 128x64 framebuffer"
    (let* ((m (make-chip8-machine :platform :schip))
           (framebuffer (chip8-machine-framebuffer m)))
      (expect (equal (array-dimensions framebuffer) '(64 128)) :to-be-truthy)
      (expect (equal (array-element-type framebuffer) '(unsigned-byte 2))
              :to-be-truthy)))
  (it "snapshots lores and hires frames as independent 2-bit arrays"
    (let ((m (make-chip8-machine :platform :schip)))
      (expect (chip8-machine-resolution m) :to-be :lores)
      (expect (chip8-machine-logical-width m) :to-be 64)
      (expect (chip8-machine-logical-height m) :to-be 32)
      (setf (aref (chip8-machine-framebuffer m) 2 3) 1)
      (let ((lores (chip8-framebuffer-snapshot m)))
        (expect (typep lores 'chip8-framebuffer) :to-be-truthy)
        (expect (equal (array-dimensions lores) '(32 64)) :to-be-truthy)
        (expect (equal (array-element-type lores) '(unsigned-byte 2))
                :to-be-truthy)
        (expect (aref lores 1 1) :to-be 1)
        (setf (aref lores 1 1) 0)
        (expect (aref (chip8-framebuffer-snapshot m) 1 1) :to-be 1))
      (set-chip8-machine-resolution! m :hires)
      (expect (chip8-machine-resolution m) :to-be :hires)
      (expect (chip8-machine-logical-width m) :to-be 128)
      (expect (chip8-machine-logical-height m) :to-be 64)
      (setf (aref (chip8-machine-framebuffer m) 63 127) 3)
      (let ((hires (chip8-framebuffer-snapshot m)))
        (expect (typep hires 'chip8-framebuffer) :to-be-truthy)
        (expect (equal (array-dimensions hires) '(64 128)) :to-be-truthy)
        (expect (equal (array-element-type hires) '(unsigned-byte 2))
                :to-be-truthy)
        (expect (aref hires 63 127) :to-be 3)
        (setf (aref hires 63 127) 0)
        (expect (aref (chip8-framebuffer-snapshot m) 63 127) :to-be 3))))
  (it "scales lores pixels across four physical cells and reads both planes"
    (let ((m (make-chip8-machine :platform :schip)))
      (display-xor-pixel! m 3 4)
      (display-xor-pixel! m 3 4 2)
      (expect (display-pixel-value m 3 4 1) :to-be 1)
      (expect (display-pixel-value m 3 4 2) :to-be 2)
      (expect (display-pixel-value m 3 4 3) :to-be 3)
      (expect (loop for y from 8 below 10
                    always (loop for x from 6 below 8
                                 always (= (aref (chip8-machine-framebuffer m) y x)
                                           3)))
              :to-be-truthy)
      (expect (aref (chip8-machine-framebuffer m) 8 8) :to-be 0)))
  (it "clears and toggles pixels"
    (let ((m (make-chip8-machine)))
      (setf (aref (chip8-machine-framebuffer m) 5 5) 1)
      (display-reset! m)
      (expect (display-pixel-value m 5 5) :to-be 0)
      (expect (display-xor-pixel! m 5 5) :to-be nil)
      (expect (display-pixel-value m 5 5) :to-be 1)))
  (it "wraps an off-screen sprite origin before clipping"
    (let ((m (make-chip8-machine :quirks (make-chip8-quirks :clipping :clip))))
      (load-bytes-into-memory m #(240) #x300)
      (load-bytes-into-memory m #(208 17) #x200)
      (setf (chip8-machine-i m) #x300
            (chip8-machine-register m 0) 66
            (chip8-machine-register m 1) 0)
      (execute-instruction! m)
      (expect (loop for x from 2 below 6 always (= (display-pixel-value m x 0) 1))
              :to-be-truthy)))
  (it-each ((:clip nil) (:wrap t))
    "clips or wraps the pixels beyond the right edge under ~A"
    (clipping wraps-p)
    (let ((m (make-chip8-machine :quirks (make-chip8-quirks :clipping clipping))))
      (load-bytes-into-memory m #(255) #x300)
      (load-bytes-into-memory m #(208 17) #x200)
      (setf (chip8-machine-i m) #x300
            (chip8-machine-register m 0) 60
            (chip8-machine-register m 1) 0)
      (execute-instruction! m)
      (expect (loop for x from 60 below 64 always (= (display-pixel-value m x 0) 1))
              :to-be-truthy)
      (expect (loop for x from 0 below 4 always (= (display-pixel-value m x 0)
                                                    (if wraps-p 1 0)))
              :to-be-truthy)))
  (it "enforces supported resolutions and logical coordinate bounds"
    (let ((modern (make-chip8-machine))
          (schip (make-chip8-machine :platform :schip)))
      (signals type-error (set-chip8-machine-resolution! modern :medium))
      (signals error (set-chip8-machine-resolution! modern :hires))
      (signals type-error (display-pixel-value modern -1 0))
      (signals type-error (display-xor-pixel! modern 0 -1))
      (signals error (display-pixel-value modern 64 0))
      (signals error (display-xor-pixel! modern 0 32))
      (set-chip8-machine-resolution! schip :hires)
      (expect (display-pixel-value schip 127 63) :to-be 0)
      (signals error (display-pixel-value schip 128 0))
      (signals error (display-xor-pixel! schip 0 64))))
  (it "leaves pixels untouched when the plane mask is zero"
    (let ((m (make-chip8-machine :platform :schip)))
      (setf (aref (chip8-machine-framebuffer m) 8 8) 3)
      (expect (display-pixel-value m 4 4 0) :to-be 0)
      (expect (display-xor-pixel! m 4 4 0) :to-be nil)
      (expect (aref (chip8-machine-framebuffer m) 8 8) :to-be 3)
      (expect (display-pixel-value m 4 4 3) :to-be 3))))
